#!/bin/sh
set -eu
umask 077
LC_ALL=C; export LC_ALL

COMMAND=$(basename "$0")
SOURCE=$0
while [ -L "$SOURCE" ]; do
  DIR=$(CDPATH= cd -P "$(dirname "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  case "$SOURCE" in /*) ;; *) SOURCE=$DIR/$SOURCE ;; esac
done
BASE=$(CDPATH= cd -P "$(dirname "$SOURCE")/.." && pwd)
CONFIG=${REMOTE_JOB_CONFIG:-$BASE/config}
[ -f "$CONFIG" ] || { echo "remote-job: missing config: $CONFIG" >&2; exit 1; }
WORK_ROOT=$(sed -n 's/^WORK_ROOT=//p' "$CONFIG" | sed -n '1p')
[ -n "$WORK_ROOT" ] || { echo "remote-job: WORK_ROOT is not configured" >&2; exit 1; }
REQUESTS=$WORK_ROOT/.remote/requests
STATUSES=$WORK_ROOT/.remote/status
CANCEL=$WORK_ROOT/.remote/cancel
STALE_AFTER=180
mkdir -p "$REQUESTS" "$STATUSES" "$CANCEL"

parse_status() {
  awk '
    /^state=/ && !have_state { state=substr($0, 7); have_state=1 }
    /^heartbeat_epoch=/ && !have_heartbeat { heartbeat=substr($0, 17); have_heartbeat=1 }
    /^updated=/ && !have_updated { updated=substr($0, 9); have_updated=1 }
    /^project=/ && !have_project { project=substr($0, 9); have_project=1 }
    END { print state; print heartbeat; print updated; print project }
  '
}

parsed_value() { printf '%s\n' "$1" | sed -n "${2}p"; }

jst_timestamp() {
  stamp=$1
  case "$stamp" in
    *Z)
      epoch=$(TZ=UTC /bin/date -j -f '%Y-%m-%dT%H:%M:%SZ' "$stamp" +%s 2>/dev/null) || {
        printf '%s\n' "$stamp"; return
      }
      TZ=Asia/Tokyo /bin/date -r "$epoch" '+%Y-%m-%dT%H:%M:%S+09:00' ;;
    *) printf '%s\n' "$stamp" ;;
  esac
}

request_updated() {
  stamp=${1%%-*}
  case "$stamp" in
    ????????T??????JST)
      printf '%s\n' "${stamp%JST}" | awk '{
        printf "%s-%s-%sT%s:%s:%s+09:00\n", substr($0,1,4), substr($0,5,2),
          substr($0,7,2), substr($0,10,2), substr($0,12,2), substr($0,14,2)
      }' ;;
    ????????T??????Z)
      epoch=$(TZ=UTC /bin/date -j -f '%Y%m%dT%H%M%SZ' "$stamp" +%s 2>/dev/null) || {
        printf '\n'; return
      }
      TZ=Asia/Tokyo /bin/date -r "$epoch" '+%Y-%m-%dT%H:%M:%S+09:00' ;;
    *) printf '\n' ;;
  esac
}

effective_state() {
  parsed=$1; state=$(parsed_value "$parsed" 1)
  case "$state" in
    running|cancelling)
      heartbeat=$(parsed_value "$parsed" 2)
      case "$heartbeat" in
        ''|*[!0-9]*) printf 'stale\n'; return ;;
      esac
      now=$(date +%s)
      if awk -v now="$now" -v heartbeat="$heartbeat" -v limit="$STALE_AFTER" \
          'BEGIN { exit !((now - heartbeat) > limit) }'; then
        printf 'stale\n'
      else printf '%s\n' "$state"; fi ;;
    *) printf '%s\n' "$state" ;;
  esac
}

display_status() {
  text=$(cat "$1")
  parsed=$(printf '%s\n' "$text" | parse_status)
  reported=$(parsed_value "$parsed" 1)
  shown=$(effective_state "$parsed")
  updated=$(jst_timestamp "$(parsed_value "$parsed" 3)")
  printf '%s\n' "$text" | awk -v shown="$shown" -v reported="$reported" -v updated="$updated" '
    /^state=/ { print "state=" shown; if (shown == "stale") print "reported_state=" reported; next }
    /^updated=/ { print "updated=" updated; next }
    { print }
  '
}

current_project() {
  root_real=$(CDPATH= cd -P "$WORK_ROOT" && pwd)
  here=$(pwd -P)
  case "$here" in
    "$root_real") printf '.\n' ;;
    "$root_real"/*) printf '%s\n' "${here#"$root_real"/}" ;;
    *) echo "remote-job: current directory is outside WORK_ROOT" >&2; return 1 ;;
  esac
}

submit() {
  [ "$#" -eq 0 ] || { echo "usage: job-submit" >&2; exit 2; }
  project=$(current_project) || exit 2
  [ -x "$WORK_ROOT/$project/run" ] || {
    echo "job-submit: current directory does not contain executable ./run" >&2; exit 2
  }
  id="$(TZ=Asia/Tokyo /bin/date +%Y%m%dT%H%M%SJST)-$(uuidgen | tr '[:upper:]' '[:lower:]')"
  tmp=$REQUESTS/.$id.tmp.$$
  trap 'rm -f "$tmp"' EXIT HUP INT TERM
  printf '%s\n' "$project" > "$tmp"
  mv "$tmp" "$REQUESTS/$id.request"
  trap - EXIT HUP INT TERM
  printf '%s\n' "$id"
}

show_one() {
  id=$1
  case "$id" in ''|*[!A-Za-z0-9-]*) echo "job-status: invalid job id" >&2; exit 2 ;; esac
  if [ -f "$STATUSES/$id.status" ]; then
    display_status "$STATUSES/$id.status"
    [ ! -f "$STATUSES/$id.log" ] || printf 'log=%s\n' "$STATUSES/$id.log"
  elif [ -f "$REQUESTS/$id.request" ]; then
    state=queued
    [ ! -f "$CANCEL/$id.cancel" ] || state=cancelling
    printf 'state=%s\nid=%s\nproject=%s\n' "$state" "$id" "$(sed -n '1p' "$REQUESTS/$id.request")"
    updated=$(request_updated "$id")
    [ -z "$updated" ] || printf 'updated=%s\n' "$updated"
  else
    echo "job-status: unknown job: $id" >&2; exit 1
  fi
}

job_list() {
  [ "$#" -eq 0 ] || { echo "usage: job-list" >&2; exit 2; }
  {
    for file in "$STATUSES"/*.status; do
      [ -e "$file" ] || continue
      id=$(basename "$file" .status)
      case "$id" in ''|*[!A-Za-z0-9-]*) continue ;; esac
      text=$(cat "$file")
      parsed=$(printf '%s\n' "$text" | parse_status)
      updated=$(jst_timestamp "$(parsed_value "$parsed" 3)")
      printf '%s\t%s\t%s\t%s\n' "$updated" "$(parsed_value "$parsed" 4)" \
        "$(effective_state "$parsed")" "$id"
    done
    for file in "$REQUESTS"/*.request; do
      [ -e "$file" ] || continue
      id=$(basename "$file" .request)
      case "$id" in ''|*[!A-Za-z0-9-]*) continue ;; esac
      [ -f "$STATUSES/$id.status" ] && continue
      state=queued
      [ ! -f "$CANCEL/$id.cancel" ] || state=cancelling
      printf '%s\t%s\t%s\t%s\n' "$(request_updated "$id")" "$(sed -n '1p' "$file")" "$state" "$id"
    done
  } | sort -r | awk -F '\t' '
    BEGIN { printf "%-28s %-11s %-53s %s\n", "DIR", "STATE", "REQUEST", "UPDATED (JST)" }
    { stamp=substr($1,1,16); gsub(/T/, " ", stamp); if (stamp == "") stamp="-"; else stamp=stamp " JST";
      printf "%-28s %-11s %-53s %s\n", $2, $3, $4, stamp }
  '
}

cancel_job() {
  [ "$#" -eq 1 ] || { echo "usage: job-cancel JOB_ID" >&2; exit 2; }
  id=$1
  case "$id" in ''|*[!A-Za-z0-9-]*) echo "job-cancel: invalid job id" >&2; exit 2 ;; esac
  if [ -f "$STATUSES/$id.status" ]; then
    text=$(cat "$STATUSES/$id.status")
    parsed=$(printf '%s\n' "$text" | parse_status)
    state=$(effective_state "$parsed")
  elif [ -f "$REQUESTS/$id.request" ]; then
    state=queued
    [ ! -f "$CANCEL/$id.cancel" ] || state=cancelling
  else
    echo "job-cancel: unknown job: $id" >&2; exit 1
  fi
  case "$state" in
    queued|running|cancelling|stale)
      if [ ! -f "$CANCEL/$id.cancel" ]; then
        tmp=$CANCEL/.$id.tmp.$$
        trap 'rm -f "$tmp"' EXIT HUP INT TERM
        printf '%s\n' "$id" > "$tmp"
        mv "$tmp" "$CANCEL/$id.cancel"
        trap - EXIT HUP INT TERM
      fi
      printf 'cancel requested: %s (%s)\n' "$id" "$state" ;;
    finished|error|cancelled)
      printf 'no action: %s is already %s\n' "$id" "$state" ;;
    *) echo "job-cancel: unknown state: $state" >&2; exit 1 ;;
  esac
}

delete_job() {
  [ "$#" -eq 1 ] || { echo "usage: job-delete JOB_ID" >&2; exit 2; }
  id=$1
  case "$id" in ''|*[!A-Za-z0-9-]*) echo "job-delete: invalid job id" >&2; exit 2 ;; esac
  if [ -f "$STATUSES/$id.status" ]; then
    text=$(cat "$STATUSES/$id.status")
    parsed=$(printf '%s\n' "$text" | parse_status)
    state=$(effective_state "$parsed")
  elif [ -f "$REQUESTS/$id.request" ]; then
    state=queued
    [ ! -f "$CANCEL/$id.cancel" ] || state=cancelling
  else
    echo "job-delete: unknown job: $id" >&2; exit 1
  fi
  case "$state" in
    finished|error|cancelled) ;;
    queued|running|cancelling|stale)
      echo "job-delete: cannot delete $id while state is $state" >&2; exit 1 ;;
    *) echo "job-delete: unknown state: $state" >&2; exit 1 ;;
  esac
  rm -f "$STATUSES/$id.status" "$STATUSES/$id.log" \
    "$REQUESTS/$id.request" "$CANCEL/$id.cancel"
  printf 'deleted: %s (%s)\n' "$id" "$state"
}

case "$COMMAND" in
  job-submit) submit "$@" ;;
  job-status) [ "$#" -eq 1 ] || { echo "usage: job-status JOB_ID" >&2; exit 2; }; show_one "$1" ;;
  job-list) job_list "$@" ;;
  job-cancel) cancel_job "$@" ;;
  job-delete) delete_job "$@" ;;
  *) echo "invoke as job-submit, job-status, job-list, job-cancel, or job-delete" >&2; exit 2 ;;
esac
